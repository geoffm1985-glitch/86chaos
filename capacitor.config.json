{
  "appId": "com.chiltonappworks.chaos86",
  "appName": "86 Chaos",
  "webDir": "build",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "hostname": "testing.86chaos.com"
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        }
      }
    }
  },
  "plugins": {
    "FirebaseMessaging": {
      "presentationOptions": [
        "alert",
        "badge",
        "sound"
      ]
    }
  }
}
