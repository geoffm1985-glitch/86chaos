{
  "name": "86chaos",
  "version": "16.0.161",
  "private": true,
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "firebase": "^10.8.1",
    "firebase-admin": "^12.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "retention:setup": "node scripts/setup-production-retention.js",
    "test": "npm run node:check && npm run lock:integrity && npm run test:source && npm run performance:split && npm run test:unit",
    "test:ci": "npm run node:check && npm run lock:integrity && npm run lint && npm run syntax && npm run test:source && npm run performance:split && npm run test:unit -- --runInBand && npm run test:rules && npm run build && npm run test:e2e && npm run test:cost",
    "validate:auth-hotfix": "node scripts/validate-auth-hotfix.js",
    "vercel:install": "npm ci --omit=dev --omit=optional --no-audit --no-fund --progress=false",
    "deploy:check": "npm run test:ci && NODE_OPTIONS=--max-old-space-size=4096 GENERATE_SOURCEMAP=false npm run build",
    "validate:audit-repair": "node scripts/validate-repair.js",
    "rules:check": "node scripts/validate-rules.js",
    "test:source": "node scripts/validate-16-0-161.js",
    "syntax:api": "node scripts/check-api-syntax.js",
    "test:unit": "npm run test:client && npm run test:server",
    "test:rules": "firebase emulators:exec --only firestore,storage \"node scripts/run-rules-tests.js\"",
    "test:e2e": "playwright test",
    "lint": "eslint \"src/**/*.{js,jsx}\" \"api/**/*.js\"",
    "syntax:py": "node scripts/check-python-syntax.js",
    "test:cost": "node scripts/run-cost-regression-tests.js",
    "backup:setup:dry-run": "node scripts/setup-native-firestore-backup.js --dry-run",
    "migrate:reminders:dry-run": "node scripts/migrate-reminder-dispatch-queue.js --dry-run",
    "migrate:schedule:dry-run": "node scripts/migrate-schedule-query-fields.js --dry-run",
    "migrate:participants:dry-run": "node scripts/migrate-reminder-participants.js --dry-run",
    "backup:setup:native": "node scripts/setup-native-firestore-backup.js",
    "migrate:reminders": "node scripts/migrate-reminder-dispatch-queue.js",
    "migrate:schedule-fields": "node scripts/migrate-schedule-query-fields.js",
    "migrate:reminder-participants": "node scripts/migrate-reminder-participants.js",
    "node:check": "node scripts/check-node-version.js",
    "lock:integrity": "node scripts/check-lock-integrity.js",
    "syntax": "npm run syntax:api && npm run syntax:py",
    "performance:split": "node scripts/validate-performance-split.js",
    "test:client": "react-scripts test --watchAll=false",
    "test:server": "node --test api/*.test.cjs",
    "migrate:workspace-memberships:dry-run": "node scripts/migrate-workspace-memberships.js",
    "migrate:workspace-memberships": "node scripts/migrate-workspace-memberships.js --execute",
    "test:play-store": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\RUN_86CHAOS_PLAY_STORE_RELEASE_GATE.ps1",
    "test:play-store:failed": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\RUN_86CHAOS_FAILED_ONLY_RELEASE_GATE.ps1",
    "test:play-store:delta": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\RUN_86CHAOS_FAILED_AND_NEW_RELEASE_GATE.ps1",
    "test:play-store:repair": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\RUN_86CHAOS_FAILED_AND_NEW_RELEASE_GATE.ps1 -SelectionMode repair",
    "test:play-store:failed-current": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\RUN_86CHAOS_FAILED_AND_NEW_RELEASE_GATE.ps1 -SelectionMode reported-failed-only"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@babel/traverse": "7.29.7",
    "@firebase/rules-unit-testing": "^3.0.3",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.6.1",
    "eslint": "^8.57.1",
    "firebase-tools": "15.24.0"
  }
}
