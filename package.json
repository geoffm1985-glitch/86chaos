{
  "name": "86chaos",
  "version": "16.0.25",
  "private": true,
  "dependencies": {
    "firebase": "^10.8.1",
    "firebase-admin": "^12.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-scripts": "5.0.1",
    "pdf-lib": "^1.17.1",
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "retention:setup": "node scripts/setup-production-retention.js",
    "test": "npm run test:source && npm run test:unit",
    "test:ci": "npm run lint && npm run syntax:api && npm run test:source && npm run test:unit && npm run test:rules && npm run build",
    "validate:auth-hotfix": "node scripts/validate-auth-hotfix.js",
    "vercel:install": "npm ci --omit=optional --no-audit --no-fund --progress=false",
    "deploy:check": "npm run test:ci && NODE_OPTIONS=--max-old-space-size=4096 GENERATE_SOURCEMAP=false npm run build",
    "validate:audit-repair": "node scripts/validate-repair.js",
    "rules:check": "node scripts/validate-rules.js",
    "test:source": "node scripts/validate-16-0-25.js",
    "syntax:api": "node scripts/check-api-syntax.js",
    "test:unit": "react-scripts test --watchAll=false",
    "test:rules": "firebase emulators:exec --only firestore,storage \"node scripts/run-rules-tests.js\"",
    "test:e2e": "npx playwright test",
    "lint": "eslint \"src/**/*.{js,jsx}\" \"api/**/*.js\""
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  }
}
