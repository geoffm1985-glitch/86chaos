<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the logo inside Android's adaptive-icon safe area; the launcher supplies its mask. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="20%"
    android:insetTop="20%"
    android:insetRight="20%"
    android:insetBottom="20%">
    <bitmap android:src="@drawable/chaos86_launcher_artwork" android:gravity="fill" />
</inset>
