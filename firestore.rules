rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {
function signedIn() { return request.auth != null; }
function authEmailMatches(value) {
let email = signedIn() ? request.auth.token.get('email', '') : '';
return email != '' && value is string && value != '' && value == email;
}
function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
function hasUserDoc() { return signedIn() && exists(userPath()); }
function userData() { return get(userPath()).data; }
function safeUserData() { return hasUserDoc() ? userData() : {}; }
function protectedFoundingAdminEmail() { return 'geoffm1985@gmail.com'; }
function isProtectedFoundingAdminUser(data) {
return data.get('email', '') == protectedFoundingAdminEmail() ||
data.get('emailLower', '') == protectedFoundingAdminEmail() ||
data.get('emailLowercase', '') == protectedFoundingAdminEmail() ||
data.get('normalizedEmail', '') == protectedFoundingAdminEmail() ||
data.get('authEmail', '') == protectedFoundingAdminEmail();
}
function privilegedSystemAccessKeys() {
return ['superAdmin', 'platformAdmin', 'systemAdministrator', 'rootAdmin', 'protectedRootAdmin', 'foundingAdministrator', 'allAccess'];
}
function authorityFlagCreateIsSafe(value) {
return value == null || (value is bool && value == false);
}
function systemAccessCreateIsSafe(data) {
let access = data.get('systemAccess', null);
return access == null ? true : (
!(access is map) ? false : (
!access.keys().hasOnly(privilegedSystemAccessKeys()) ? false : (
!authorityFlagCreateIsSafe(access.get('superAdmin', false)) ? false : (
!authorityFlagCreateIsSafe(access.get('platformAdmin', false)) ? false : (
!authorityFlagCreateIsSafe(access.get('systemAdministrator', false)) ? false : (
!authorityFlagCreateIsSafe(access.get('rootAdmin', false)) ? false : (
!authorityFlagCreateIsSafe(access.get('protectedRootAdmin', false)) ? false : (
!authorityFlagCreateIsSafe(access.get('foundingAdministrator', false)) ? false :
authorityFlagCreateIsSafe(access.get('allAccess', false))
)
)
)
)
)
)
)
);
}
function platformAuthorityCreateIsSafe(data) {
return !authorityFlagCreateIsSafe(data.get('isSuperAdmin', false)) ? false : (
!authorityFlagCreateIsSafe(data.get('superAdmin', false)) ? false : (
!authorityFlagCreateIsSafe(data.get('protectedRootAdmin', false)) ? false : (
!authorityFlagCreateIsSafe(data.get('protectedFoundingAdmin', false)) ? false : (
!authorityFlagCreateIsSafe(data.get('foundingAdministrator', false)) ? false : (
!authorityFlagCreateIsSafe(data.get('rootAdmin', false)) ? false :
systemAccessCreateIsSafe(data)
)
)
)
)
);
}
function protectedFoundingAdminKeys() {
return ['isSuperAdmin', 'superAdmin', 'systemAccess', 'platformAccess', 'protectedRootAdmin', 'protectedFoundingAdmin', 'foundingAdministrator', 'rootAdmin', 'isAdmin', 'isActive', 'disabled', 'isDisabled', 'deactivated', 'archived', 'deleted', 'role', 'accountRole', 'permissions'];
}
function protectedFoundingAdminUserUpdateIsSafe() {
return !isProtectedFoundingAdminUser(resource.data) ||
!request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFoundingAdminKeys());
}
function isSuperAdmin() {
let u = safeUserData();
let access = u.get('systemAccess', {});
return signedIn() && (
request.auth.token.get('superAdmin', false) == true ||
u.get('isSuperAdmin', false) == true ||
(access is map && access.get('superAdmin', false) == true)
);
}
function membershipDataFromUser(u, restId) {
let memberships = u.get('memberships', {});
return restId is string && memberships is map && memberships.get(restId, {}) is map
? memberships.get(restId, {})
: {};
}
function membershipDataFor(restId) {
let u = safeUserData();
return membershipDataFromUser(u, restId);
}
function isTenantMatch(restId) {
let u = safeUserData();
let ids = u.get('workspaceIds', []);
let member = membershipDataFor(restId);
return signedIn() && restId is string && (
u.get('restaurantId', '') == restId ||
(ids is list && ids.hasAny([restId])) ||
member.get('isActive', false) == true
);
}
function permissionDataFromUserAndMember(u, member, restId) {
let memberPerms = member.get('permissions', {});
let userPerms = u.get('permissions', {});
return member.get('isActive', false) == true && memberPerms is map
? memberPerms
: (u.get('restaurantId', '') == restId && userPerms is map ? userPerms : {});
}
function permissionDataFor(restId) {
let u = safeUserData();
let member = membershipDataFromUser(u, restId);
return permissionDataFromUserAndMember(u, member, restId);
}
function restaurantPath(restId) { return /databases/$(database)/documents/restaurants/$(restId); }
function hasRestaurantDoc(restId) { return restId is string && exists(restaurantPath(restId)); }
function restaurantData(restId) { return get(restaurantPath(restId)).data; }
function safeRestaurantData(restId) { return hasRestaurantDoc(restId) ? restaurantData(restId) : {}; }
function currentUserSystemAccessMap(u) {
let access = u.get('systemAccess', {});
return access is map ? access : {};
}
function currentAuthTokenSuperAdmin() {
return signedIn() && request.auth.token.get('superAdmin', false) == true;
}
function currentUserDocSuperAdminFrom(u) {
let access = currentUserSystemAccessMap(u);
return u.get('isSuperAdmin', false) == true || access.get('superAdmin', false) == true;
}
function currentUserSuperAdminLean() {
let u = safeUserData();
return currentAuthTokenSuperAdmin() || currentUserDocSuperAdminFrom(u);
}
function currentUserMemberPermsFrom(member) {
let perms = member.get('permissions', {});
return perms is map ? perms : {};
}
function currentUserLegacyPermsFrom(u, restId) {
let perms = u.get('permissions', {});
return u.get('restaurantId', '') == restId && perms is map ? perms : {};
}
function currentUserActiveMemberOwnerFrom(member) {
return member.get('isActive', false) == true && (
member.get('isOwner', false) == true ||
member.get('accountOwner', false) == true ||
member.get('workspaceOwner', false) == true ||
member.get('accountRole', '') == 'owner'
);
}
function currentUserLegacyOwnerFrom(u, restId) {
return u.get('restaurantId', '') == restId && (
u.get('isOwner', false) == true ||
u.get('accountOwner', false) == true ||
u.get('owner', false) == true ||
u.get('workspaceOwner', false) == true ||
u.get('accountRole', '') == 'owner'
);
}
function currentUserOwnerAuthorityFrom(u, member, restId) {
return currentUserActiveMemberOwnerFrom(member) || currentUserLegacyOwnerFrom(u, restId);
}
function currentUserMemberTeamAuthorityFrom(member, memberPerms) {
return member.get('isActive', false) == true && (
member.get('isAdmin', false) == true ||
memberPerms.get('team', false) == true
);
}
function currentUserLegacyTeamAuthorityFrom(u, legacyPerms, restId) {
return u.get('restaurantId', '') == restId && (
u.get('isAdmin', false) == true ||
legacyPerms.get('team', false) == true
);
}
function currentUserStaffAuthorityFromDoc(restId) {
let u = safeUserData();
let member = membershipDataFromUser(u, restId);
let memberPerms = currentUserMemberPermsFrom(member);
let legacyPerms = currentUserLegacyPermsFrom(u, restId);
return signedIn() && restId is string && (
currentUserDocSuperAdminFrom(u) ||
currentUserOwnerAuthorityFrom(u, member, restId) ||
currentUserMemberTeamAuthorityFrom(member, memberPerms) ||
currentUserLegacyTeamAuthorityFrom(u, legacyPerms, restId)
);
}
function currentUserOwnerAuthorityFromRestaurant(restId) {
let restaurant = safeRestaurantData(restId);
return signedIn() && restId is string && (
authEmailMatches(restaurant.get('ownerEmail', '')) ||
authEmailMatches(restaurant.get('ownerEmailLower', '')) ||
authEmailMatches(restaurant.get('ownerUserEmail', '')) ||
restaurant.get('ownerUserId', '') == request.auth.uid ||
restaurant.get('ownerUid', '') == request.auth.uid
);
}
function currentUserOwnerAuthorityLean(restId) {
let u = safeUserData();
let member = membershipDataFromUser(u, restId);
return signedIn() && restId is string && (
currentAuthTokenSuperAdmin() ||
currentUserDocSuperAdminFrom(u) ||
currentUserOwnerAuthorityFrom(u, member, restId) ||
currentUserOwnerAuthorityFromRestaurant(restId)
);
}
function currentUserCanEditWagesLean(restId) {
let u = safeUserData();
let member = membershipDataFromUser(u, restId);
let memberPerms = currentUserMemberPermsFrom(member);
let legacyPerms = currentUserLegacyPermsFrom(u, restId);
return signedIn() && restId is string && (
currentAuthTokenSuperAdmin() ||
currentUserDocSuperAdminFrom(u) ||
currentUserOwnerAuthorityFrom(u, member, restId) ||
currentUserOwnerAuthorityFromRestaurant(restId) ||
(member.get('isActive', false) == true && memberPerms.get('wageEdit', false) == true) ||
(u.get('restaurantId', '') == restId && legacyPerms.get('wageEdit', false) == true)
);
}
function isRestaurantOwner(restId) {
let u = safeUserData();
let member = membershipDataFor(restId);
let restaurant = safeRestaurantData(restId);
return signedIn() && restId is string && (
authEmailMatches(restaurant.get('ownerEmail', '')) ||
authEmailMatches(restaurant.get('ownerEmailLower', '')) ||
authEmailMatches(restaurant.get('ownerUserEmail', '')) ||
restaurant.get('ownerUserId', '') == request.auth.uid ||
restaurant.get('ownerUid', '') == request.auth.uid ||
(member.get('isActive', false) == true && (
member.get('isOwner', false) == true ||
member.get('accountOwner', false) == true ||
member.get('workspaceOwner', false) == true ||
member.get('accountRole', '') == 'owner'
)) ||
(u.get('restaurantId', '') == restId && (
u.get('isOwner', false) == true ||
u.get('accountOwner', false) == true ||
u.get('owner', false) == true ||
u.get('workspaceOwner', false) == true ||
u.get('accountRole', '') == 'owner'
))
);
}
function isAdminFor(restId) {
let u = safeUserData();
let member = membershipDataFor(restId);
return signedIn() && restId is string && (
(member.get('isActive', false) == true && member.get('isAdmin', false) == true) ||
(u.get('restaurantId', '') == restId && u.get('isAdmin', false) == true)
);
}
function hasPermFor(restId, perm) {
let perms = permissionDataFor(restId);
return signedIn() && restId is string && perms.get(perm, false) == true;
}
function hasAnyPermissionFor(restId, a, b, c, d, e, f) {
let perms = permissionDataFor(restId);
return signedIn() && restId is string && (
perms.get(a, false) == true ||
perms.get(b, false) == true ||
perms.get(c, false) == true ||
perms.get(d, false) == true ||
perms.get(e, false) == true ||
perms.get(f, false) == true
);
}
function hasWorkspaceAuthorityFor(restId, a, b, c, d, e, f) {
let u = safeUserData();
let member = membershipDataFor(restId);
let perms = permissionDataFor(restId);
let access = u.get('systemAccess', {});
let restaurant = safeRestaurantData(restId);
return signedIn() && restId is string && (
request.auth.token.get('superAdmin', false) == true ||
u.get('isSuperAdmin', false) == true ||
(access is map && access.get('superAdmin', false) == true) ||
authEmailMatches(restaurant.get('ownerEmail', '')) ||
authEmailMatches(restaurant.get('ownerEmailLower', '')) ||
authEmailMatches(restaurant.get('ownerUserEmail', '')) ||
restaurant.get('ownerUserId', '') == request.auth.uid ||
restaurant.get('ownerUid', '') == request.auth.uid ||
(member.get('isActive', false) == true && (
member.get('isOwner', false) == true ||
member.get('accountOwner', false) == true ||
member.get('workspaceOwner', false) == true ||
member.get('accountRole', '') == 'owner' ||
member.get('isAdmin', false) == true ||
perms.get(a, false) == true ||
perms.get(b, false) == true ||
perms.get(c, false) == true ||
perms.get(d, false) == true ||
perms.get(e, false) == true ||
perms.get(f, false) == true
)) ||
(u.get('restaurantId', '') == restId && (
u.get('isOwner', false) == true ||
u.get('accountOwner', false) == true ||
u.get('owner', false) == true ||
u.get('workspaceOwner', false) == true ||
u.get('accountRole', '') == 'owner' ||
u.get('isAdmin', false) == true ||
perms.get(a, false) == true ||
perms.get(b, false) == true ||
perms.get(c, false) == true ||
perms.get(d, false) == true ||
perms.get(e, false) == true ||
perms.get(f, false) == true
))
);
}
function currentUserStaffAuthorityFromCachedUser(u, restId) {
let member = membershipDataFromUser(u, restId);
let memberPerms = currentUserMemberPermsFrom(member);
let legacyPerms = currentUserLegacyPermsFrom(u, restId);
return currentUserDocSuperAdminFrom(u) ? true : (
currentUserOwnerAuthorityFrom(u, member, restId) ? true : (
currentUserMemberTeamAuthorityFrom(member, memberPerms) ? true : (
currentUserLegacyTeamAuthorityFrom(u, legacyPerms, restId) ? true :
currentUserOwnerAuthorityFromRestaurant(restId)
)
)
);
}
function canManageStaffFromCurrentUser(u, restId) {
return signedIn() && restId is string && restId != '' ? (
currentAuthTokenSuperAdmin() ? true : currentUserStaffAuthorityFromCachedUser(u, restId)
) : false;
}
function canManageStaff(restId) {
let u = safeUserData();
return canManageStaffFromCurrentUser(u, restId);
}
function isHrOwnerFor(restId) {
return isRestaurantOwner(restId);
}
function isHrAdminFor(restId) {
return isAdminFor(restId);
}
function hasHrPermissionFor(restId) {
return hasPermFor(restId, 'hr');
}
function canChooseHrAccess(restId) {
return isSuperAdmin() || isHrOwnerFor(restId);
}
function canManageHr(restId) {
return isSuperAdmin() || isHrOwnerFor(restId) || isHrAdminFor(restId) || hasHrPermissionFor(restId);
}
function trainingManualPath(manualId) {
return /databases/$(database)/documents/trainingManuals/$(manualId);
}
function publishedTrainingManualExists(manualId, restId) {
return manualId is string &&
exists(trainingManualPath(manualId)) &&
get(trainingManualPath(manualId)).data.restaurantId == restId &&
get(trainingManualPath(manualId)).data.status == 'Published';
}
function trainingManualRecordIsValid(data) {
return data.restaurantId is string &&
data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
data.version is string && data.version.size() > 0 && data.version.size() <= 24 &&
data.status in ['Uploading', 'Published', 'Archived'] &&
data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 255 &&
data.fileType in ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'text/plain'] &&
data.fileSize is number && data.fileSize > 0 && data.fileSize <= 15 * 1024 * 1024 &&
(!('originalFileSize' in data) || (data.originalFileSize is number && data.originalFileSize > 0 && data.originalFileSize <= 50 * 1024 * 1024)) &&
(!('compressed' in data) || data.compressed is bool) &&
(!('compression' in data) || data.compression in ['', 'gzip']) &&
(!('storedFileType' in data) || data.storedFileType in ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'text/plain', 'application/gzip']) &&
data.storagePath is string;
}
function optionalString(data, key, maxSize) {
return !(key in data) || (data[key] is string && data[key].size() <= maxSize);
}
function optionalNumber(data, key, maxAbs) {
return !(key in data) || (data[key] is number && data[key] >= -maxAbs && data[key] <= maxAbs);
}
function optionalBool(data, key) {
return !(key in data) || data[key] is bool;
}
function optionalDateTime(data, key) {
return !(key in data) ||
data[key] is timestamp ||
(data[key] is string && data[key].size() <= 40);
}
function dateTimePresent(data, key) {
return key in data && (
data[key] is timestamp ||
(data[key] is string && data[key].size() > 0 && data[key].size() <= 40)
);
}
function isoDateOrEmpty(value) {
return value is string && (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
}
function onboardingTaskRecordIsValid(data) {
return data.restaurantId is string && data.restaurantId.size() > 0 && data.restaurantId.size() <= 160 &&
data.userId is string && data.userId.size() > 0 && data.userId.size() <= 160 &&
data.employeeName is string && data.employeeName.size() > 0 && data.employeeName.size() <= 200 &&
data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
isoDateOrEmpty(data.get('dueDate', '')) &&
data.completed is bool &&
data.assignedById is string && data.assignedById.size() > 0 && data.assignedById.size() <= 160 &&
data.assignedByName is string && data.assignedByName.size() > 0 && data.assignedByName.size() <= 200 &&
optionalString(data, 'completedBy', 160) &&
optionalString(data, 'updatedBy', 200) &&
optionalDateTime(data, 'completedAt') &&
dateTimePresent(data, 'createdAt') &&
dateTimePresent(data, 'updatedAt');
}
function certificationRecordIsValid(data) {
return data.restaurantId is string && data.restaurantId.size() > 0 && data.restaurantId.size() <= 160 &&
data.userId is string && data.userId.size() > 0 && data.userId.size() <= 160 &&
data.employeeName is string && data.employeeName.size() > 0 && data.employeeName.size() <= 200 &&
data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
optionalString(data, 'issuer', 120) &&
isoDateOrEmpty(data.get('issuedDate', '')) &&
isoDateOrEmpty(data.get('expiresDate', '')) &&
optionalString(data, 'notes', 500) &&
data.createdById is string && data.createdById.size() > 0 && data.createdById.size() <= 160 &&
optionalString(data, 'updatedBy', 200) &&
dateTimePresent(data, 'createdAt') &&
dateTimePresent(data, 'updatedAt');
}
function performanceNoteRecordIsValid(data) {
return data.restaurantId is string && data.restaurantId.size() > 0 && data.restaurantId.size() <= 160 &&
data.userId is string && data.userId.size() > 0 && data.userId.size() <= 160 &&
data.employeeName is string && data.employeeName.size() > 0 && data.employeeName.size() <= 200 &&
data.type in ['Coaching', 'Recognition', 'Performance Review', 'Attendance', 'Corrective Action', 'Manager Follow-up'] &&
data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
data.confidentialSummary is string && data.confidentialSummary.size() > 0 && data.confidentialSummary.size() <= 3000 &&
optionalString(data, 'nextSteps', 1600) &&
data.confidential == true &&
data.createdById is string && data.createdById.size() > 0 && data.createdById.size() <= 160 &&
data.createdByName is string && data.createdByName.size() > 0 && data.createdByName.size() <= 200 &&
optionalString(data, 'updatedBy', 200) &&
dateTimePresent(data, 'createdAt') &&
dateTimePresent(data, 'updatedAt');
}
function onboardingSelfCompletionIsSafe() {
return onboardingTaskRecordIsValid(request.resource.data) &&
resource.data.userId == request.auth.uid &&
request.resource.data.userId == resource.data.userId &&
request.resource.data.restaurantId == resource.data.restaurantId &&
request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed', 'completedAt', 'completedBy', 'updatedAt', 'updatedBy']) &&
(
(request.resource.data.completed == true && request.resource.data.get('completedBy', '') == request.auth.uid && dateTimePresent(request.resource.data, 'completedAt')) ||
(request.resource.data.completed == false && request.resource.data.get('completedBy', '') == '' && request.resource.data.get('completedAt', '') == '')
);
}
function restaurantProtectedSubscriptionKeys() {
return [
'subscription', 'planId', 'planType', 'subscriptionStatus', 'billingStatus', 'billingProvider',
'billingNotes', 'customPrice', 'trialDays', 'isFounderBeta', 'founderBeta', 'selectedFutureTier',
'futurePlanId', 'betaStartedAt', 'betaEndsAt', 'betaExtendedUntil', 'founderDiscountPercent',
'founderDiscountEndsAt', 'integrations', 'integrationsLocked', 'integrationSecrets',
'featureAccess', 'featureOverrides'
];
}
function restaurantOwnerUpdateIsSafe(restId) {
return restId is string && isOwnerOfRestaurantDoc() &&
!request.resource.data.diff(resource.data).affectedKeys().hasAny(restaurantProtectedSubscriptionKeys());
}
function workspaceSubscription(restId) {
let restaurant = safeRestaurantData(restId);
let subscription = restaurant.get('subscription', {});
return subscription is map ? subscription : {};
}
function rawWorkspacePlanId(restId) {
let restaurant = safeRestaurantData(restId);
let subscription = workspaceSubscription(restId);
return subscription.get('planId', restaurant.get('planId', ''));
}
function workspacePlanId(restId) {
let plan = rawWorkspacePlanId(restId);
return plan in ['shift', 'operations', 'smart_kitchen', 'owner_pro', 'master_admin']
? plan
: 'smart_kitchen';
}
function workspaceSubscriptionStatus(restId) {
let restaurant = safeRestaurantData(restId);
let subscription = workspaceSubscription(restId);
return subscription.get('status', restaurant.get('subscriptionStatus', restaurant.get('billingStatus', 'active')));
}
function hasActiveEntitlement(restId) {
let subscription = workspaceSubscription(restId);
return hasRestaurantDoc(restId) &&
subscription.get('entitlementActive', true) != false &&
!(workspaceSubscriptionStatus(restId) in ['canceled', 'cancelled', 'trial_expired', 'expired', 'disabled', 'suspended']);
}
function planAtLeastOperations(restId) {
return hasActiveEntitlement(restId) && workspacePlanId(restId) in ['operations', 'smart_kitchen', 'owner_pro', 'master_admin'];
}
function planAtLeastSmartKitchen(restId) {
return hasActiveEntitlement(restId) && workspacePlanId(restId) in ['smart_kitchen', 'owner_pro', 'master_admin'];
}
function planAtLeastOwnerPro(restId) {
return hasActiveEntitlement(restId) && workspacePlanId(restId) in ['owner_pro', 'master_admin'];
}
function canEditWages(restId) {
return isSuperAdmin() || isRestaurantOwner(restId) || hasAnyPermissionFor(restId, 'wageEdit', '', '', '', '', '');
}
function canChooseWageAccess(restId) { return isSuperAdmin() || isRestaurantOwner(restId); }
function canManageWorkspaceSettings(restId) {
return isSuperAdmin() || isRestaurantOwner(restId) || hasAnyPermissionFor(restId, 'settings', 'branding', '', '', '', '');
}
function canUseMenuIntelligence(restId) {
return isSuperAdmin() || (planAtLeastSmartKitchen(restId) && hasWorkspaceAuthorityFor(restId, 'menuIntelligence', 'inventory', 'inventoryEdit', 'ops', '', ''));
}
function canReadBasicInventory(restId) {
return isSuperAdmin() || (planAtLeastOperations(restId) && hasWorkspaceAuthorityFor(restId, 'inventory', 'inventoryEdit', 'ops', '', '', ''));
}
function canWriteBasicInventory(restId) {
return isSuperAdmin() || (planAtLeastOperations(restId) && hasWorkspaceAuthorityFor(restId, 'inventory', 'inventoryEdit', '', '', '', ''));
}
function canReadSmartInventory(restId) {
return planAtLeastSmartKitchen(restId) &&
hasWorkspaceAuthorityFor(restId, 'inventory', 'inventoryEdit', 'ops', '', '', '');
}
function canWriteSmartInventory(restId) {
return planAtLeastSmartKitchen(restId) &&
hasWorkspaceAuthorityFor(restId, 'inventory', 'inventoryEdit', '', '', '', '');
}
function canReadFinancials(restId) {
return hasWorkspaceAuthorityFor(restId, 'sales', 'salesRead', 'financialRead', 'labor', 'laborRead', 'wageView') || hasWorkspaceAuthorityFor(restId, 'wageEdit', '', '', '', '', '');
}
function canWriteFinancials(restId) {
return hasWorkspaceAuthorityFor(restId, 'sales', 'salesEdit', 'financialEdit', '', '', '');
}
function canReadOperationsFinancials(restId) { return canReadFinancials(restId) && planAtLeastOperations(restId); }
function canWriteOperationsFinancials(restId) { return canWriteFinancials(restId) && planAtLeastOperations(restId); }
function canReadSmartFinancials(restId) { return canReadFinancials(restId) && planAtLeastSmartKitchen(restId); }
function canWriteSmartFinancials(restId) { return canWriteFinancials(restId) && planAtLeastSmartKitchen(restId); }
function canReadBackOffice(restId) {
return isSuperAdmin() || (planAtLeastOwnerPro(restId) && hasWorkspaceAuthorityFor(restId, 'backOffice', 'ownerTools', 'settings', 'financialEdit', '', ''));
}
function canWriteBackOffice(restId) { return canReadBackOffice(restId); }
function backOfficeRecordIsValid(data) {
return data.restaurantId is string &&
data.type in ['deposit', 'document', 'approval', 'quickbooks', 'quickbooks_mapping', 'quickbooks_bill_draft', 'quickbooks_vendor_match', 'quickbooks_vendor_credit_draft', 'quickbooks_sync_event', 'quickbooks_accountant_packet', 'quickbooks_owner_rollup', 'quickbooks_sync_health', 'ownerReport'] &&
data.status is string &&
data.createdAt != null &&
data.updatedAt != null;
}
function canReadOwnPunch(data) {
return signedIn() && data.restaurantId is string && isTenantMatch(data.restaurantId) &&
(data.employeeId == request.auth.uid || data.userId == request.auth.uid || data.createdBy == request.auth.uid);
}
