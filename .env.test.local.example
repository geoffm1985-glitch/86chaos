# 86 CHAOS APP STORE / PLAY STORE RELEASE GATE
# Copy this file to .env.test.local in the app root.
# Never commit .env.test.local.

# Safe TESTING/PREVIEW deployment only. Never use app.86chaos.com.
APP_URL=https://YOUR-LATEST-TESTING-PREVIEW.vercel.app
CHAOS_BASE_URL=https://YOUR-LATEST-TESTING-PREVIEW.vercel.app
CHAOS_E2E_BASE_URL=https://YOUR-LATEST-TESTING-PREVIEW.vercel.app
CHAOS_EXPECTED_VERSION=16.0.32
CHAOS_RELEASE_GATE=true

# Dedicated accounts in the TESTING Firebase project.
OWNER_EMAIL=
OWNER_PASSWORD=
MANAGER_EMAIL=
MANAGER_PASSWORD=
STAFF_EMAIL=
STAFF_PASSWORD=
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=

# The gate creates this exact disposable workspace name. It matches the
# System Administrator > Platform Operations cleanup tool.
CHAOS_QA_WORKSPACE_NAME=86 Chaos Full Audit QA Restaurant
CHAOS_QA_WORKSPACE=86 Chaos Full Audit QA Restaurant
CHAOS_QA_RESTAURANT_ID=
CHAOS_QA_CREATE_RESTAURANT=true
CHAOS_ALLOW_MUTATION=true
CHAOS_QA_USE_PROD_FIREBASE=false
CHAOS_EXPECTED_TEST_FIREBASE_PROJECT_ID=chaos-test-d1601

# Set true only when deliberately leaving the QA restaurant behind for review.
# It can then be removed from System Administrator > Platform Operations.
CHAOS_KEEP_QA_RESTAURANT=false

# Notification contract evidence. Use TEST recipients only.
CHAOS_EXPECTED_BUG_EMAIL_TO=
CHAOS_EXPECTED_PUSH_RECIPIENT_EMAIL=
CHAOS_REQUIRE_NOTIFICATION_PIPELINE=true

# Strict release thresholds.
CHAOS_MIN_RUNTIME_JS_COVERAGE=90
CHAOS_MIN_JEST_LINES=90
CHAOS_MIN_JEST_STATEMENTS=90
CHAOS_MIN_JEST_FUNCTIONS=85
CHAOS_MIN_JEST_BRANCHES=80
CHAOS_REQUIRE_EVERY_SOURCE_FILE_COVERED=true
CHAOS_MAX_NOOP_ROUTE_WRITES=2
CHAOS_MAX_REPEAT_ROUTE_LISTENS=6
CHAOS_RELEASE_GATE_WORKERS=1
CHAOS_FULL_AUDIT_WORKERS=1

# Local emulators used by the rules and deterministic cost gates.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

DISABLE_ESLINT_PLUGIN=false
GENERATE_SOURCEMAP=false
